{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@usfm-tools/types": ["../shared-types/src/index.ts"],
      "@usfm-tools/types/*": ["../shared-types/src/*"]
    }
  },
  "include": ["src/**/*"]
}
