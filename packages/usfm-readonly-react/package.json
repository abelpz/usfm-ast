{
  "name": "@usfm-tools/usfm-readonly-react",
  "version": "0.1.2",
  "description": "Read-only USFM → React view (segment pipeline inspired by usfm-editor-app conflict-renderers; optional @usfm-tools/editor-themes CSS)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/default.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/default.css"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "test": "jest --config jest.config.cjs",
    "check-types": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <21",
    "@usfm-tools/editor-themes": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@usfm-tools/editor-themes": {
      "optional": true
    }
  },
  "dependencies": {
    "@usfm-tools/types": "workspace:*",
    "@usfm-tools/usj-core": "workspace:*",
    "@usfm-tools/parser": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "^19.0.10",
    "@usfm-tools/parser": "workspace:*",
    "jest": "^29.5.0",
    "react": "^19.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abelpz/usfm-ast.git",
    "directory": "packages/usfm-readonly-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "usfm",
    "usj",
    "react",
    "scripture",
    "readonly",
    "usfm-tools"
  ]
}
